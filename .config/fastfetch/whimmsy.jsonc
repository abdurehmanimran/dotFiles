{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "width": 30,
    "type": "small",
    "padding": {
      "top": 3,
      "left": 6,
      "right": 3,
    },
    "color": {
      "1": "red",
    },
  },
  "display": {
    "separator": " ",
  },
  "modules": [
    // Adds empty lines at the top to push modules down to the center
    {
      "type": "custom",
      "format": "\n\n",
    },
    {
      "type": "os",
      "key": "{#31}    distro  {#}",
    },
    {
      "type": "kernel",
      "key": "{#35}    kernel  󰏗{#}",
    },
    {
      "type": "packages",
      "key": "{#33}  packages  󰏖{#}",
    },
    {
      "type": "wm",
      "key": "{#32}        wm  󱂬{#}",
    },
    {
      "type": "shell",
      "key": "{#32}     shell  {#}",
    },
    {
      "type": "terminal",
      "key": "{#36}  terminal  {#}",
    },
    {
      "type": "cpu",
      "key": "{#32}       cpu  {#}",
      "format": "@ {freq-max}",
    },
    {
      "type": "memory",
      "key": "{#32}       ram  󰍛{#}",
      "format": "{used} ({percentage})",
    },
    {
      "type": "gpu",
      "key": "{#33}       gpu  󰢮{#}",
      "format": "{name} [{type}]",
    },
    {
      "type": "display",
      "key": "{#35}   display  󰍹{#}",
    },
    {
      "type": "uptime",
      "key": "{#31}    uptime  󱎫{#}",
    },
    // Adds empty lines at the bottom to balance out the spacing
    {
      "type": "custom",
      "format": "\n\n",
    },
  ],
}
