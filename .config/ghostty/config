# command = "fish --init-command 'bicon sa'"
command = "bicon sa"

# Font Configuration
font-size = 16
# font-family = "JetBrainsMono NF SemiBold"
font-family = "IosevkaCustom"
# font-family = "Comic Mono"
# Window Configuration
# window-decoration = true
maximize = true
window-padding-x = 5
window-padding-y = 0
background-opacity = 0.83
background-blur = true
background-blur-radius = 52
window-save-state = always

# Cursor Configuration
cursor-style = block
cursor-style-blink = true
custom-shader = "~/.config/ghostty/cursor_smear.glsl"
# Scrollback
scrollback-limit = 10023

# Terminal features
mouse-hide-while-typing = true
copy-on-select = false
confirm-close-surface = false

# Disable annoying copied to clipboard
app-notifications = no-clipboard-copy,no-config-reload

# Key bindings for common actions
#keybind = ctrl+c=copy_to_clipboard
#keybind = ctrl+v=paste_from_clipboard
keybind = ctrl+shift+n=new_window
keybind = ctrl+t=new_tab
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size


# New Splits
# keybind = ctrl+s>p>r=new_split:right
# keybind = ctrl+s>p>l=new_split:left
# keybind = ctrl+s>p>u=new_split:up
# keybind = ctrl+s>p>d=new_split:down

keybind = alt+v=new_split:right

# Navigation Keybinds
keybind = alt+h=goto_split:left
keybind = alt+j=goto_split:bottom
keybind = alt+k=goto_split:top
keybind = alt+l=goto_split:right


# Material 3 UI elements
unfocused-split-opacity = 0.95
unfocused-split-fill = #44464f

# Tab configuration
gtk-titlebar = false

# Shell integration
shell-integration = detect
shell-integration-features = cursor,sudo,title,no-cursor
keybind = shift+enter=text:\n

# Rando stuff
gtk-single-instance = true

# Dank color generation
# config-file = ./config-dankcolors
theme = noctalia
